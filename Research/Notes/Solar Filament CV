   raise FloatingPointError(f'Nonfinite prediction: {path.name}')\n    return probability\n\ndef full_probability(probability):\n    resized = Image.fromarray(np.asarray(probability, dtype=np.float32)).resize(\n        (2048, 2048), Image.Resampling.BILINEAR)\n    return np.asarray(resized, dtype=np.float32)\n\ndef contrast_foreground(filename, threshold):\n    image = small_image(filename)\n    disk = ndi.binary_erosion(image > 0.08, iterations=max(1, CFG['image_size']//128))\n    background = ndi.gaussian_filter(image, sigma=CFG['image_size']/32)\n    return disk & ((background - image) > threshold)\n\ndef instance_rles(probability, threshold, min_area):\n    if min_area < 1 or not 0 <= threshold <= 1:\n        raise ValueError('Invalid threshold or minimum area.')\n    binary = full_probability(probability) >= threshold\n    labels, count = ndi.label(binary, structure=np.ones((3, 3), dtype=np.uint8))\n    areas = np.bincount(labels.ravel())\n    result = []\n    for label in range(1, count+1):\n        if areas[label] >= min_area:\n            mask = np.asfortranarray(labels == label, dtype=np.uint8)\n            result.append(mask_utils.encode(mask))\n    return result\n\ndef local_scores(predicted, truth):\n    n_pred, n_true = len(predicted), len(truth)\n    overlaps = (mask_utils.iou(predicted, truth, [0]*n_true)\n                if n_pred and n_true else np.zeros((n_pred, n_true)))\n    matched = []\n    if n_pred and n_true:\n        valid = overlaps > 0.5\n        # Maximum cardinality first, then overlap; greedy matching can lose true positives.\n        rewards = valid * (1 + overlaps / (min(n_pred, n_true) + 1))\n        rows, columns = linear_sum_assignment(-rewards)\n        matched = [float(overlaps[r, c]) for r, c in zip(rows, columns) if valid[r, c]]\n    tp = len(matched); fp = n_pred-tp; fn = n_true-tp\n    denominator = tp + 0.5*fp + 0.5*fn\n    pq = sum(matched)/denominator if denominator else 1.0\n    pred_union, true_union = union_mask(predicted).astype(bool), union_mask(truth).astype(bool)\n    intersection = np.count_nonzero(pred_union & true_union)\n    union = np.count_nonzero(pred_union | true_union)\n    pixels = np.count_nonzero(pred_union) + np.count_nonzero(true_union)\n    return dict(pq=pq, dice=2*intersection/pixels if pixels else 1.0,\n                iou=intersection/union if union else 1.0, tp=tp, fp=fp, fn=fn,\n                split_relations=int(np.count_nonzero((overlaps > 0.1).sum(axis=0) > 1)),\n                merge_relations=int(np.count_nonzero((overlaps > 0.1).sum(axis=1) > 1)))\n\ndef evaluate(names, parameters, probability_cache=None):\n    rows = []\n    for filename in names:\n        if parameters['method'] == 'unet':\n            probability = (probability_cache[filename] if probability_cache is not None\n                           else predict_probability(train_lookup[filename]))\n            threshold = parameters['threshold']\n        elif parameters['method'] == 'contrast':\n            probability = contrast_foreground(filename, parameters['contrast_threshold']).astype(np.float32)\n            threshold = 0.5\n        else:\n            raise ValueError('Unknown segmentation method.')\n        predicted = instance_rles(probability, threshold, parameters['min_area'])\n        for record in records_by_name[filename]:\n            rows.append(dict(filename=filename, image_id=record['id'],\n                             **local_scores(predicted, gt_rles(record['id']))))\n    if not rows:\n        raise ValueError('Evaluation set is empty.')\n    # Average annotators per image, then physical images; do not overweight triply labeled images.\n    grouped = defaultdict(list)\n    for row in rows: grouped[row['filename']].append(row)\n    metrics = {key: float(np.mean([np.mean([r[key] for r in group]) for group in grouped.values()]))\n               for key in ['pq', 'dice', 'iou', 'tp', 'fp', 'fn', 'split_relations', 'merge_relations']}\n    return metrics, rows\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"calibrate","cell_type":"code","source":"if RUN_CALIBRATION:\n    selected_names = list(split_names['tune'])\n    random.Random(CFG['seed']).shuffle(selected_names)\n    if CFG['tune_image_limit'] is not None:\n        selected_names = selected_names[:CFG['tune_image_limit']]\n    if not selected_names:\n        raise ValueError('Calibration requires at least one tuning image.')\n    probability_cache = {n: predict_probability(train_lookup[n]) for n in tqdm(selected_names, desc='Tuning probabilities')}\n    tuning_results = []\n    for method in ['unet', 'contrast']:\n        thresholds = CFG['thresholds'] if method == 'unet' else CFG['contrast_thresholds']\n        for threshold, area in tqdm(list(itertools.product(thresholds, CFG['min_areas'])), desc=method):\n            parameters = dict(method=method, min_area=area)\n            parameters['threshold' if method == 'unet' else 'contrast_threshold'] = threshold\n            scores, _ = evaluate(selected_names, parameters, probability_cache)\n            tuning_results.append(dict(parameters=parameters, scores=scores))\n    selected = {method: max((r for r in tuning_results if r['parameters']['method'] == method),\n                           key=lambda r: r['scores']['pq'])['parameters'] for method in ['unet', 'contrast']}\n    calibration = dict(config=dict(CFG), annotation_sha256=annotation_sha256,\n        checkpoint_sha256=CHECKPOINT_SHA256,\n        smoke_test=SMOKE_TEST, split_manifest=manifest, tuning_filenames=selected_names,\n        selected=selected, candidates=tuning_results)\n    write_json(OUTPUT_DIR / 'calibration.json', calibration)\n    del probability_cache\nelse:\n    with (INPUT_DIR / 'calibration.json').open() as stream:\n        calibration = json.load(stream)\n    if (calibration['config'] != CFG or calibration['annotation_sha256'] != annotation_sha256\n            or calibration['smoke_test'] != SMOKE_TEST or calibration['split_manifest'] != manifest\n            or calibration['checkpoint_sha256'] != CHECKPOINT_SHA256):\n        raise ValueError('Saved calibration does not match this experiment.')\n    selected = calibration['selected']\nprint('Selected on tuning PQ only:', selected)\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"c702315b","cell_type":"markdown","source":"## 4. Compare learned and classical CV on an untouched holdout\n\nThe contrast baseline separates locally dark pixels from a smoothed background inside an eroded solar disk; it is an intensity-based **heuristic**, not a trained SVM or ESAIR Anomalyzer. It can confuse sunspots, disk/limb artifacts and clouds with filaments. Since observations are grayscale, RGB color clustering would add no independent color information. A learned model can exploit shape and context instead of intensity alone.\n\nPQ uses one-to-one matching at IoU > 0.5, ignoring chirality. Split/merge diagnostics count overlap relations at IoU > 0.1 and are not an official metric. Each annotator is evaluated separately; we average annotators within a physical image, then images. Both-empty prediction/truth scores are defined as one; one-empty scores are zero. Keep holdout untouched after reading these results. Use separate grouped folds for further experiments.","metadata":{}},{"id":"holdout-evidence","cell_type":"code","source":"holdout_results = {}\nholdout_rows = {}\nfor method in ['unet', 'contrast']:\n    started = time.perf_counter()\n    scores, rows = evaluate(tqdm(split_names['holdout'], desc=f'Holdout {method}'), selected[method])\n    holdout_results[method] = dict(scores=scores, seconds=time.perf_counter()-started,\n                                  image_count=len(split_names['holdout']), annotation_set_count=len(rows))\n    holdout_rows[method] = rows\n    with (OUTPUT_DIR / f'holdout_{method}.csv').open('w', newline='') as stream:\n        writer = csv.DictWriter(stream, fieldnames=list(rows[0]))\n        writer.writeheader(); writer.writerows(rows)\nwrite_json(OUTPUT_DIR / 'holdout_summary.json', holdout_results)\nprint(json.dumps(holdout_results, indent=2))\nfig, axes = plt.subplots(1, 3, figsize=(13, 3))\nfor axis, metric in zip(axes, ['pq', 'dice', 'iou']):\n    for method, rows in holdout_rows.items():\n        by_file = defaultdict(list)\n        for row in rows: by_file[row['filename']].append(row[metric])\n        axis.hist([np.mean(v) for v in by_file.values()], bins=np.linspace(0, 1, 11), alpha=0.5, label=method)\n    axis.set_title(f'Holdout {metric.upper()}'); axis.legend()\nfig.tight_layout(); fig.savefig(OUTPUT_DIR / 'holdout_distributions.png', dpi=150)\nplt.show()\n\npreview_name = split_names['holdout'][0]\npredicted = instance_rles(predict_probability(train_lookup[preview_name]),\n                          selected['unet']['threshold'], selected['unet']['min_area'])\nrecord = records_by_name[preview_name][0]\nfig, axes = plt.subplots(1, 3, figsize=(15, 5))\nwith Image.open(train_lookup[preview_name]) as image: full_image = np.asarray(image)\nfor axis in axes: axis.imshow(full_image, cmap='gray'); axis.axis('off')\naxes[0].set_title('Grayscale observation')\naxes[1].contour(union_mask(gt_rles(record['id'])), levels=[0.5], colors=['red'], linewidths=0.5)\naxes[1].set_title('One annotator ground truth')\nif predicted:\n    axes[2].contour(union_mask(predicted), levels=[0.5], colors=['cyan'], linewidths=0.5)\naxes[2].set_title('U-Net + components (no geometry grouping)')\nfig.savefig(OUTPUT_DIR / 'holdout_overlay.png', dpi=150, bbox_inches='tight'); plt.show()\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"35144a6b","cell_type":"markdown","source":"## 5. Test inference and strict submission validation\n\nThe U-Net checkpoint is the predeclared submission model, regardless of which method wins on holdout. Probabilities are bilinearly restored to 2048 x 2048 **before** thresholding and extracting instances. No fabricated foreground or empty RLE row is inserted. If any test image has no retained instances, export stops and lists those images: inspect them and confirm the organizer's policy for genuine zero-detection images before submitting. Do not tune against hidden test labels or invent detections to satisfy a file checker.\n\nAll RLE strings are decoded and round-tripped before writing. A draft is written atomically only when all test images have valid, nonempty predicted instances and unique IDs. The first three test images, probability maps, and mask outlines are saved in `test_preview.png` for inspection even if export stops. `SMOKE_TEST=True` uses a separately named CSV which the upload cell refuses. Outputs are under `/kaggle/working/<RUN_NAME>/`.\n\nFor offline reproduction, attach the experiment folder containing `best_model.pt`, `calibration.json`, and `split_manifest.json`, restore the same configuration and disable training/calibration. This export path has no pretrained-weight download.","metadata":{}},{"id":"export-submission","cell_type":"code","source":"submission_rows, prediction_audit = [], []\nsubmission_path = None\nempty_predictions = []\nstarted = time.perf_counter()\n\nif not test_paths:\n    raise ValueError(\"No test images found.\")\n\npreview_count = min(3, len(test_paths))\npreview_figure, preview_axes = plt.subplots(\n    preview_count, 3,\n    figsize=(12, 4 * preview_count),\n    squeeze=False,\n)\n\nfor test_index, path in enumerate(\n    tqdm(test_paths, desc=\"Full-resolution test instances\")\n):\n    probability = predict_probability(path)\n    predicted = instance_rles(\n        probability,\n        selected[\"unet\"][\"threshold\"],\n        selected[\"unet\"][\"min_area\"],\n    )\n\n    if test_index < preview_count:\n        with Image.open(path) as image:\n            observation = np.asarray(image)\n\n        preview_axes[test_index, 0].imshow(observation, cmap=\"gray\")\n        preview_axes[test_index, 0].set_title(path.name, fontsize=9)\n\n        preview_axes[test_index, 1].imshow(\n            full_probability(probability),\n            cmap=\"magma\",\n            vmin=0,\n            vmax=1,\n        )\n        preview_axes[test_index, 1].set_title(\"Filament probability\")\n\n        preview_axes[test_index, 2].imshow(observation, cmap=\"gray\")\n\n        if predicted:\n            preview_axes[test_index, 2].contour(\n                union_mask(predicted),\n                levels=[0.5],\n                colors=[\"cyan\"],\n                linewidths=0.5,\n            )\n\n        preview_axes[test_index, 2].set_title(\n            f\"{len(predicted)} predicted instances\"\n        )\n\n        for axis in preview_axes[test_index]:\n            axis.axis(\"off\")\n\n    if not predicted:\n        empty_predictions.append(path.name)\n\n    prediction_audit.append({\n        \"filename\": path.name,\n        \"instances\": len(predicted),\n        \"foreground_pixels\": (\n            int(mask_utils.area(mask_utils.merge(predicted)))\n            if predicted else 0\n        ),\n    })\n\n    for index, rle in enumerate(predicted, 1):\n        counts = rle[\"counts\"].decode(\"ascii\")\n        mask = mask_utils.decode({\n            \"size\": list(FULL_SHAPE),\n            \"counts\": counts.encode(\"ascii\"),\n        })\n\n        if mask.shape != FULL_SHAPE or not mask.any():\n            raise ValueError(f\"Invalid/empty filament mask: {path.name}\")\n\n        roundtrip = mask_utils.encode(\n            np.asfortranarray(mask, dtype=np.uint8)\n        )[\"counts\"].decode(\"ascii\")\n\n        if roundtrip != counts:\n            raise ValueError(f\"COCO RLE round-trip failed: {path.name}\")\n\n        submission_rows.append({\n            \"filament_id\": f\"{path.stem}_{index}\",\n            \"segmentation_rle\": counts,\n        })\n\npreview_figure.tight_layout()\npreview_figure.savefig(\n    OUTPUT_DIR / \"test_preview.png\",\n    dpi=150,\n    bbox_inches=\"tight\",\n)\nplt.show()\nplt.close(preview_figure)\n\nwrite_json(\n    OUTPUT_DIR / \"test_prediction_audit.json\",\n    {\n        \"images\": prediction_audit,\n        \"seconds\": time.perf_counter() - started,\n        \"empty_predictions\": empty_predictions,\n        \"smoke_test\": SMOKE_TEST,\n    },\n)\n\n# Validate complete inference without requiring a detection in every image.\nprocessed_names = [record[\"filename\"] for record in prediction_audit]\nexpected_names = {path.name for path in test_paths}\n\nif (\n    len(processed_names) != len(test_paths)\n    or len(set(processed_names)) != len(processed_names)\n    or set(processed_names) != expected_names\n):\n    raise ValueError(\"Test inference coverage is incomplete or duplicated.\")\n\nids = [row[\"filament_id\"] for row in submission_rows]\nif len(ids) != len(set(ids)):\n    raise ValueError(\"Duplicate filament IDs.\")\n\nexpected_counts = {\n    Path(record[\"filename\"]).stem: record[\"instances\"]\n    for record in prediction_audit\n    if record[\"instances\"] > 0\n}\n\nactual_counts = {}\nfor identifier in ids:\n    stem = identifier.rsplit(\"_\", 1)[0]\n    actual_counts[stem] = actual_counts.get(stem, 0) + 1\n\nif actual_counts != expected_counts:\n    raise ValueError(\"CSV instance counts differ from the inference audit.\")\n\n# Zero detections are a reported model outcome, not an export exception.\nif not submission_rows:\n    print(\n        \"WARNING: No filaments were predicted anywhere. \"\n        \"Audit and previews saved; no CSV written.\"\n    )\nelse:\n    if SMOKE_TEST:\n        output_filename = \"smoke_submission.csv\"\n    elif empty_predictions:\n        output_filename = \"submission_candidate.csv\"\n    else:\n        output_filename = \"submission.csv\"\n\n    output_path = OUTPUT_DIR / output_filename\n    temporary_path = output_path.with_suffix(\".csv.tmp\")\n\n    with temporary_path.open(\"w\", newline=\"\") as stream:\n        writer = csv.DictWriter(\n            stream,\n            fieldnames=[\"filament_id\", \"segmentation_rle\"],\n        )\n        writer.writeheader()\n        writer.writerows(submission_rows)\n\n    with temporary_path.open(newline=\"\") as stream:\n        reader = csv.DictReader(stream)\n        if (\n            reader.fieldnames != [\"filament_id\", \"segmentation_rle\"]\n            or list(reader) != submission_rows\n        ):\n            raise ValueError(\"CSV read-back validation failed.\")\n\n    temporary_path.replace(output_path)\n    submission_path = output_path\n\n    manifest_filename = (\n        \"submission_candidate_manifest.json\"\n        if empty_predictions\n        else \"submission_manifest.json\"\n    )\n\n    write_json(\n        OUTPUT_DIR / manifest_filename,\n        {\n            \"smoke_test\": SMOKE_TEST,\n            \"rows\": len(submission_rows),\n            \"images\": len(test_paths),\n            \"zero_detection_images\": empty_predictions,\n            \"zero_detection_policy\": (\n                \"unverified; omit filament rows\"\n                if empty_predictions\n                else \"not applicable\"\n            ),\n            \"csv_sha256\": hashlib.sha256(\n                submission_path.read_bytes()\n            ).hexdigest(),\n            \"checkpoint_sha256\": CHECKPOINT_SHA256,\n            \"parameters\": selected[\"unet\"],\n        },\n    )\n\n    print(\"CSV saved:\", submission_path)\n    print(\"Predicted filament rows:\", len(submission_rows))\n\nprint(\"Test images processed:\", len(prediction_audit))\nprint(\"Images with zero detections:\", len(empty_predictions))\n\nfor filename in empty_predictions:\n    print(\" -\", filename)\n\nif empty_predictions:\n    print(\n        \"WARNING: Zero-detection images have no filament rows. \"\n        \"No masks were fabricated. Kaggle acceptance of this \"\n        \"representation remains unverified.\"\n    )\n\nprint(\"No upload performed.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"123b3