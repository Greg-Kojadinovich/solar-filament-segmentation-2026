        return None\n\n    if submission_path is None:\n        print(\"NOT READY: the prediction/export cell did not produce a CSV.\")\n        return None\n\n    source = Path(submission_path)\n\n    if source.name not in {\"submission.csv\", \"submission_candidate.csv\"}:\n        print(\"NOT READY: unexpected CSV filename:\", source.name)\n        return None\n\n    manifest_name = (\n        \"submission_candidate_manifest.json\"\n        if source.name == \"submission_candidate.csv\"\n        else \"submission_manifest.json\"\n    )\n\n    try:\n        manifest = json.loads(\n            (source.parent / manifest_name).read_text()\n        )\n\n        with source.open(newline=\"\") as stream:\n            reader = csv.DictReader(stream)\n            columns = reader.fieldnames\n            rows = list(reader)\n\n        valid = (\n            isinstance(manifest, dict)\n            and manifest.get(\"smoke_test\") is False\n            and manifest.get(\"parameters\") == selected[\"unet\"]\n            and manifest.get(\"images\") == len(test_paths)\n            and manifest.get(\"checkpoint_sha256\")\n            == hashlib.sha256(CHECKPOINT_PATH.read_bytes()).hexdigest()\n            and manifest.get(\"csv_sha256\")\n            == hashlib.sha256(source.read_bytes()).hexdigest()\n            and columns == [\"filament_id\", \"segmentation_rle\"]\n            and bool(rows)\n            and rows == submission_rows\n            and manifest.get(\"rows\") == len(rows)\n            and len({row[\"filament_id\"] for row in rows}) == len(rows)\n        )\n\n        if not valid:\n            print(\n                \"NOT READY: CSV, checkpoint, configuration, or manifest \"\n                \"did not pass validation. Do not submit a stale CSV.\"\n            )\n            return None\n\n        destination = Path(\"/kaggle/working/submission.csv\")\n\n        if source.resolve() != destination.resolve():\n            temporary = destination.with_suffix(\".csv.tmp\")\n            shutil.copyfile(source, temporary)\n\n            if (\n                hashlib.sha256(temporary.read_bytes()).hexdigest()\n                != manifest[\"csv_sha256\"]\n            ):\n                temporary.unlink()\n                print(\"NOT READY: copied CSV failed checksum verification.\")\n                return None\n\n            temporary.replace(destination)\n\n        if (\n            source.name == \"submission_candidate.csv\"\n            or manifest.get(\"zero_detection_images\")\n        ):\n            print(\n                \"WARNING: images with zero detections have no filament \"\n                \"rows. No masks were fabricated. Kaggle acceptance of \"\n                \"this representation remains unverified.\"\n            )\n\n        print(\"LOCAL CHECKS PASSED\")\n        print(\"Submission file:\", destination)\n        print(\"Filament rows:\", len(rows))\n        print(\"Test images processed:\", manifest[\"images\"])\n        print(\"No API upload performed.\")\n        print(\n            \"After Run All finishes, save the completed notebook version, \"\n            \"click Kaggle's Submit button, and select this submission.csv.\"\n        )\n        return destination\n\n    except (OSError, UnicodeError, json.JSONDecodeError, csv.Error) as error:\n        print(\n            f\"NOT READY: submission preparation failed \"\n            f\"({type(error).__name__}): {error}\"\n        )\n        return None\n\n\nmanual_submission_path = prepare_submission()\nsubmission_ready = manual_submission_path is not None\n\nif not submission_ready:\n    print(\"Do not submit an older CSV remaining in the output directory.\")","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"paper-plan","cell_type":"markdown","source":"## 7. Paper evidence and reproducibility package\n\nAfter the full Kaggle run, use the saved metrics and figures in the organizer's four-page template. \n\nSuggested report structure:\n1. **Problem and related work:** H-alpha filament instance segmentation; distinguish Anomalyzer quality control from the poster's U-Net/MIoU/grouping/ConvNeXt pipeline. Cite SoftwareX, ICDMW, U-Net, and PQ. This notebook is an established-model baseline, not a novel algorithm claim.\n2. **Data and method:** annotation version/hash; separate annotator targets; day-grouped split; grayscale normalization; 512-pixel resizing and its limitations; pretrained encoder, Dice+BCE, augmentation, optimizer, epoch/checkpoint selection; connected components and calibrated minimum area in original pixels.\n3. **Experiments:** exact tuning candidates, holdout image counts, PQ/Dice/IoU distributions and split/merge relations; U-Net versus contrast on identical splits. Record hardware, seconds and package versions. Additional valid ablations include FPN, resolution/tiling, MIoU/BF1 implementation, geometry grouping, quality-aware weighting and multiple seeds. These are **not implemented or measured claims** here.\n4. **Results and limitations:** quote only measured full-run numbers and the actual returned leaderboard score. Include representative and failure overlays, not just the first image. Annotator disagreement, same-day rather than multi-day event grouping, thinning from resizing, nearby-filament merges, intensity confusion with sunspots, and calibration-set selection are limitations. Add confidence intervals/grouped folds before claiming significance. Keep holdout untouched.\n\nPublish this notebook, exact `requirements.txt`, `best_model.pt`, `calibration.json`, `split_manifest.json`, and method documentation in the public code repository.","metadata":{}},{"id":"save-evidence","cell_type":"code","source":"versions = {name: importlib.metadata.version(name) for name in [\n    'torch', 'torchvision', 'segmentation-models-pytorch', 'numpy', 'Pillow', 'scipy', 'pycocotools', 'matplotlib']}\nwith (OUTPUT_DIR / 'requirements.txt').open('w') as stream:\n    subprocess.run([sys.executable, '-m', 'pip', 'list', '--format=freeze'], stdout=stream, check=True)\nif INPUT_DIR != OUTPUT_DIR:\n    for filename in ['best_model.pt', 'calibration.json']:\n        shutil.copy2(INPUT_DIR / filename, OUTPUT_DIR / filename)\nwrite_json(OUTPUT_DIR / 'experiment.json', dict(run_name=RUN_NAME, config=dict(CFG),\n    smoke_test=SMOKE_TEST, python=sys.version, packages=versions, device=str(DEVICE),\n    annotation_sha256=annotation_sha256, holdout=holdout_results, selected_parameters=selected,\n    leaderboard_score=None, leaderboard_score_note='Record the actual API/site result after submission.'))\nprint('Evidence package:', OUTPUT_DIR)\n\n","metadata":{"trusted":true},"outputs":[],"execution_count":null},{"id":"c9372bef-d86e-43ac-9112-2036af5fccdd","cell_type":"code","source":"","metadata":{"trusted":true},"outputs":[],"execution_count":null}]}